<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_default_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/textViewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Municipalities in China"
        android:textColor="@color/color_text_dark"
        android:textSize="24sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/imageViewMap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="Map of China showing the four municipalities"
        android:scaleType="centerInside"
        android:src="@drawable/chinese_municipalities" />

    <TextView
        android:id="@+id/textViewLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="I want to know about:"
        android:textColor="@color/color_text_dark"
        android:textSize="18sp" />

    <EditText
        android:id="@+id/editTextMunicipality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="name of a municipality"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLines="1" />

</LinearLayout>
